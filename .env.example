# Nexora Enterprise Intelligence Platform environment template
# Copy to .env for local development. Do not commit real secrets.

# Runtime
ENVIRONMENT=development
AUTH_MODE=dev
DEFAULT_ORG_ID=replace-with-default-org-id
CLOUD_ADVISOR_APP_URL=http://localhost:8513
CLOUD_ADVISOR_CREDENTIAL_KEY=replace-with-local-development-key

# Synthetic demonstration mode is disabled by default. When enabled, it only
# serves the immutable bundled dataset to tenants whose ID begins with "demo-".
NEXORA_DEMO_MODE=false

# Governed persistence. Production requires durable storage and a stable key.
NEXORA_UNIVERSAL_EVIDENCE_DB=replace-with-durable-database-path
NEXORA_PROSPECT_DATA_ROOT=var/prospect_data
NEXORA_PROSPECT_DATA_KEY=replace-with-fernet-key-from-secret-manager
JWT_SECRET=replace-with-high-entropy-secret
PUE_PILOT_DEV_MODE=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-supabase-service-or-anon-key

# Optional PostgreSQL / Streamlit Cloud compatibility
PGDATABASE=cloud_advisor
PGUSER=replace-with-postgres-user
PGPASSWORD=replace-with-postgres-password
PGHOST=replace-with-postgres-host
PGPORT=5432

# Optional AI features
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=replace-with-certified-model-name

# Optional AWS connector placeholders
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_ROLE_ARN=replace-with-aws-role-arn
AWS_EXTERNAL_ID=replace-with-aws-external-id

# Optional Azure connector placeholders
AZURE_TENANT_ID=replace-with-azure-tenant-id
AZURE_CLIENT_ID=replace-with-azure-client-id
AZURE_CLIENT_SECRET=replace-with-azure-client-secret
AZURE_SUBSCRIPTION_ID=replace-with-azure-subscription-id
AZURE_SECRET_REF=replace-with-secret-reference

# Optional GCP connector placeholders
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_SERVICE_ACCOUNT_SECRET_REF=replace-with-service-account-secret-reference
GCP_REGIONS=us-central1

# Optional API/worker and telemetry services
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
BACKGROUND_JOBS_ENABLED=false
SCHEDULER_TZ=UTC
SENTRY_DSN=

# Optional billing and notifications
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
YAGMAIL_USER=reports@example.com
YAGMAIL_PASSWORD=replace-with-email-app-password
FEEDBACK_REPORT_EMAIL_TO=ops@example.com
