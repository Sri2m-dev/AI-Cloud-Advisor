# ============================================================
# SCHEDULER & AUTOMATION CONFIGURATION
# ============================================================
# Copy this to .env.local and customize for your environment

# Enable background job scheduler (APScheduler)
# Set to 'true' to enable hourly escalations and alerts
BACKGROUND_JOBS_ENABLED=true

# Timezone for cron-based jobs (used for daily jobs at specific hours)
# See IANA timezone list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
SCHEDULER_TZ=UTC
# Examples:
# SCHEDULER_TZ=America/New_York
# SCHEDULER_TZ=Europe/London
# SCHEDULER_TZ=Asia/Tokyo


# ============================================================
# EMAIL ALERTS (SMTP)
# ============================================================
# Required for email notifications to work
# Supports Gmail, Office 365, custom SMTP servers

# Gmail Example:
# - Enable "Less secure app access" or use App Password
# - Account: your-email@gmail.com
# - App Password: generated from Security settings

ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=your-email@gmail.com
ALERT_SMTP_PASSWORD=your-app-password-or-password
ALERT_SMTP_FROM=alerts@yourcompany.com

# Office 365 Example:
# ALERT_SMTP_SERVER=smtp.office365.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USERNAME=your-email@company.onmicrosoft.com
# ALERT_SMTP_PASSWORD=your-office365-password
# ALERT_SMTP_FROM=alerts@company.com


# ============================================================
# WEBHOOK ALERTS
# ============================================================
# Configure channel webhook URLs in the database, not here:
# 
# INSERT INTO alert_configs (name, channel, active, webhook_url)
# VALUES 
#   ('Engineering Slack', 'slack', true, 'https://hooks.slack.com/services/T.../B.../...'),
#   ('Ops Teams', 'teams', true, 'https://outlook.webhook.office.com/webhookb2/...'),
#   ('Custom Webhook', 'webhook', true, 'https://your-api.example.com/alerts');
#
# See SCHEDULER_SETUP.md for detailed instructions


# ============================================================
# CELERY INTEGRATION (Optional - for distributed jobs)
# ============================================================
# Only needed if running Celery workers in addition to APScheduler

# Redis broker for Celery
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Celery timezone
# CELERY_TIMEZONE=UTC

# Optional: Celery worker concurrency
# CELERY_WORKER_CONCURRENCY=4


# ============================================================
# LOGGING
# ============================================================
# Control verbosity of scheduler logs

LOG_LEVEL=INFO
# Options: DEBUG (verbose), INFO (default), WARNING (less verbose)


# ============================================================
# QUICK REFERENCE - Job Schedule
# ============================================================
#
# With BACKGROUND_JOBS_ENABLED=true, the following jobs run:
#
# Every 5-15 minutes:
#   - KPI refresh (15 min)
#
# Every 1 hour:
#   - Cost ingestion
#   - Anomaly scanning
#   - Legacy alert engine
#   - SLA Escalation (NEW) ⭐
#   - Alert Processor (NEW) ⭐
#
# Daily:
#   - Optimization recommendations (2 AM UTC)
#   - Report generation (3 AM UTC)
#
# Adjust SCHEDULER_TZ to match your local time if desired
#
# ============================================================
