# Nexora production backend-only credentials.
#
# NEVER provide this file to the frontend service.
# NEVER commit the real .env.production.backend file.
#
# SUPABASE_SERVICE_ROLE_KEY:
#   Privileged Supabase backend credential used by server-side
#   ingestion, Data Fabric and administrative workloads.
#
# SUPABASE_SERVICE_KEY:
#   Compatibility alias required by legacy server-side paths.
#   When required, configure it with the same backend credential.
#
# Real values belong only in:
#   .env.production.backend

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
