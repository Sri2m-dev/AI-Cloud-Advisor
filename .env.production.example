# ============================================================
# Nexora Local Production Runtime
# Copy this file to .env.production and supply real values.
# Never commit .env.production.
# ============================================================

ENVIRONMENT=production

# ------------------------------------------------------------
# Authentication
# Generate a strong random secret locally.
# ------------------------------------------------------------
JWT_SECRET=replace-with-strong-random-secret

# ------------------------------------------------------------
# Supabase / PostgreSQL-backed Nexora data plane
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-runtime-supabase-key

# Optional when specific server-side workflows require it.

# ------------------------------------------------------------
# Universal Evidence
# Runtime path is overridden by docker-compose.production.yml
# and stored in a persistent Docker volume.
# ------------------------------------------------------------
NEXORA_UNIVERSAL_EVIDENCE_DB=/var/lib/nexora/evidence/nexora_evidence.db

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
DEFAULT_ORG_ID=default-org
NEXORA_DEMO_MODE=false
SCHEDULER_TZ=UTC
BACKGROUND_JOBS_ENABLED=false

# ------------------------------------------------------------
# AI — optional until Ask Nexora live AI is required
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ------------------------------------------------------------
# Cloud connectors — leave blank until explicitly activated
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_SECRET_REF=

GCP_PROJECT_ID=
GCP_REGIONS=
GCP_SERVICE_ACCOUNT_SECRET_REF=

# ------------------------------------------------------------
# Optional integrations
# ------------------------------------------------------------
SENTRY_DSN=
STRIPE_SECRET_KEY=
YAGMAIL_USER=
YAGMAIL_PASSWORD=
FEEDBACK_REPORT_EMAIL_TO=
